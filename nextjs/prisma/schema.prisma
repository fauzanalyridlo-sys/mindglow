generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration BigInt

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration BigInt

  @@index([expiration], map: "cache_locks_expiration_index")
}

model daily_check_ins {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt
  mood         Int       @db.SmallInt
  energy       Int       @db.SmallInt
  sleep_hours  Decimal   @db.Decimal(3, 1)
  activity     String?
  condition    String?
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  checkin_date DateTime  @db.Date
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "daily_check_ins_user_id_foreign")

  @@unique([user_id, checkin_date], map: "daily_check_ins_user_date_unique")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.VarChar(255)
  queue      String   @db.VarChar(255)
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(0)

  @@index([connection, queue, failed_at], map: "failed_jobs_connection_queue_failed_at_index")
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int    @db.SmallInt
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

model journals {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  content    String
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "journals_user_id_foreign")
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement())
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt
  name           String
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt?
  ip_address    String? @db.VarChar(45)
  user_agent    String?
  payload       String
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model users {
  id                        BigInt                      @id @default(autoincrement())
  name                      String                      @db.VarChar(255)
  email                     String                      @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at         DateTime?                   @db.Timestamp(0)
  password                  String?                     @db.VarChar(255)
  remember_token            String?                     @db.VarChar(100)
  created_at                DateTime?                   @db.Timestamp(0)
  updated_at                DateTime?                   @db.Timestamp(0)
  username                  String?                     @unique(map: "users_username_unique") @db.VarChar(255)
  phone                     String?                     @db.VarChar(255)
  academic_tasks            academic_tasks[]
  ai_rate_limits            ai_rate_limits[]
  daily_check_ins           daily_check_ins[]
  email_verification_tokens email_verification_tokens[]
  journals                  journals[]
  mindglow_sessions         mindglow_sessions[]
  oauth_accounts            oauth_accounts[]
  momo_pet momo_pets?
}

model mindglow_sessions {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    BigInt
  token_hash String   @unique @db.VarChar(64)
  expires_at DateTime @db.Timestamp(0)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mindglow_sessions_user_id_foreign")

  @@index([user_id])
  @@index([expires_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model academic_tasks {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  name       String   @db.VarChar(255)
  course     String   @db.VarChar(255)
  deadline   DateTime @db.Date
  priority   String   @db.VarChar(10)
  type       String   @db.VarChar(10)
  completed  Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "academic_tasks_user_id_foreign")

  @@index([user_id, completed], map: "academic_tasks_user_completed_idx")
  @@index([user_id, deadline], map: "academic_tasks_user_deadline_idx")
  @@index([user_id])
}

model ai_rate_limits {
  id            BigInt   @id @default(autoincrement())
  user_id       BigInt
  window_type   String   @db.VarChar(10)
  window_start  DateTime @db.Timestamptz(6)
  request_count Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, window_type, window_start], map: "ai_rate_limits_unique_window")
  @@index([window_start])
}

model email_verification_tokens {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  token_hash String   @unique @db.VarChar(64)
  expires_at DateTime @db.Timestamp(0)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "email_verification_tokens_user_id_foreign")

  @@index([user_id])
  @@index([expires_at])
}

model oauth_accounts {
  id                  BigInt   @id @default(autoincrement())
  user_id             BigInt
  provider            String   @db.VarChar(50)
  provider_account_id String   @db.VarChar(255)
  created_at          DateTime @default(now()) @db.Timestamp(0)
  users               users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "oauth_accounts_user_id_foreign")

  @@unique([provider, provider_account_id], map: "oauth_accounts_provider_account_unique")
  @@unique([user_id, provider], map: "oauth_accounts_user_provider_unique")
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth_rate_limits {
  rate_key      String   @id @db.VarChar(64)
  window_start  DateTime @db.Timestamptz(6)
  request_count Int      @default(1)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([window_start])
}


model momo_pets {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt   @unique
  score        Int      @default(0)
  energy       Int      @default(100) @db.SmallInt
  happiness    Int      @default(100) @db.SmallInt
  fullness     Int      @default(100) @db.SmallInt
  last_checkin DateTime? @db.Date
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @updatedAt @db.Timestamp(0)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "momo_pets_user_id_foreign")
}
